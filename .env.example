# ==============================================================================
# Production Docker Environment Variables
# ==============================================================================

# Image tag from GitHub Container Registry (GHCR)
# Replace 'your_github_username' with your GitHub username or organization in lowercase:
IMAGE_TAG=ghcr.io/your_github_username/dockerize:latest

# Note: If your GHCR package is private, authenticate on the server once with:
# echo "YOUR_GITHUB_PAT" | docker login ghcr.io -u YOUR_GITHUB_USERNAME --password-stdin
